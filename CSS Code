  height: 105px;
  background-image: url("https://64.media.tumblr.com/ec8aca7326a7e80a43564ac267592508/7fd5200fb91e31d8-a3/s1280x1920/213d2f41679c25f3ac81f1017560b4c95dade98b.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
